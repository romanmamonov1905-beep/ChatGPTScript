--=========================================================
-- DRAGGING
--=========================================================

local dragging = false
local dragStart
local startPosition

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = Main.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--=========================================================
-- OPEN / CLOSE
--=========================================================

local Open = true

local function SetOpen(value)
	Open = value
	Main.Visible = value
end

CloseButton.MouseButton1Click:Connect(function()
	SetOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == CONFIG.Keybind then
		SetOpen(not Open)
	end

	if input.KeyCode == Enum.KeyCode.F6 then
		if Freecam.Active then
			StopFreecam()
		end
	end
end)

--=========================================================
-- TRAINING TARGET LOCK
--=========================================================

local function FindClosestTrainingTarget()
	local targets = GetTrainingTargets()

	local closest = nil
	local shortest = math.huge

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, target in ipairs(targets) do
		local root = target:FindFirstChild("HumanoidRootPart")

		if root then
			local screenPosition, visible =
				Camera:WorldToViewportPoint(root.Position)

			if visible then
				local screen = Vector2.new(
					screenPosition.X,
					screenPosition.Y
				)

				local distance = (screen - center).Magnitude

				if distance < shortest then
					shortest = distance
					closest = root
				end
			end
		end
	end

	return closest
end

--=========================================================
-- TRAINING AURA
--=========================================================

local function UpdateTrainingAura()
	if not CONFIG.TrainingAura then
		for _, dummy in ipairs(GetTrainingTargets()) do
			local highlight = dummy:FindFirstChild(
				"TrainingAuraHighlight"
			)

			if highlight then
				highlight:Destroy()
			end
		end

		return
	end

	local myCharacter = LocalPlayer.Character
	local myRoot =
		myCharacter and
		myCharacter:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		return
	end

	for _, dummy in ipairs(GetTrainingTargets()) do
		local root = dummy:FindFirstChild("HumanoidRootPart")

		if root then
			local distance =
				(root.Position - myRoot.Position).Magnitude

			local highlight = dummy:FindFirstChild(
				"TrainingAuraHighlight"
			)

			if distance <= 20 then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "TrainingAuraHighlight"
					highlight.FillColor = CONFIG.Accent
					highlight.OutlineColor = CONFIG.Text
					highlight.FillTransparency = 0.45
					highlight.DepthMode =
						Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = dummy
				end
			elseif highlight then
				highlight:Destroy()
			end
		end
	end
end

--=========================================================
-- FREECAM INPUT
--=========================================================

local keys = {
	W = false,
	A = false,
	S = false,
	D = false,
	Space = false,
	Ctrl = false,
	Shift = false,
}

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	local keyMap = {
		[Enum.KeyCode.W] = "W",
		[Enum.KeyCode.A] = "A",
		[Enum.KeyCode.S] = "S",
		[Enum.KeyCode.D] = "D",
		[Enum.KeyCode.Space] = "Space",
		[Enum.KeyCode.LeftControl] = "Ctrl",
		[Enum.KeyCode.LeftShift] = "Shift",
	}

	local key = keyMap[input.KeyCode]

	if key then
		keys[key] = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local keyMap = {
		[Enum.KeyCode.W] = "W",
		[Enum.KeyCode.A] = "A",
		[Enum.KeyCode.S] = "S",
		[Enum.KeyCode.D] = "D",
		[Enum.KeyCode.Space] = "Space",
		[Enum.KeyCode.LeftControl] = "Ctrl",
		[Enum.KeyCode.LeftShift] = "Shift",
	}

	local key = keyMap[input.KeyCode]

	if key then
		keys[key] = false
	end
end)

--=========================================================
-- MOUSE LOOK
--=========================================================

local lastMousePosition = UserInputService:GetMouseLocation()

UserInputService.InputChanged:Connect(function(input)
	if not Freecam.Active then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta

		Freecam.Rotation = Freecam.Rotation + Vector2.new(
			-math.rad(delta.Y * 0.12),
			-math.rad(delta.X * 0.12)
		)

		Freecam.Rotation = Vector2.new(
			math.clamp(
				Freecam.Rotation.X,
				-math.rad(89),
				math.rad(89)
			),
			Freecam.Rotation.Y
		)
	end
end)

--=========================================================
-- FPS TRACKING
--=========================================================

local FPS = 60
local fpsTimer = 0
local fpsFrames = 0

--=========================================================
-- MAIN RENDER LOOP
--=========================================================

RunService.RenderStepped:Connect(function(dt)

	-- FPS
	fpsFrames += 1
	fpsTimer += dt

	if fpsTimer >= 1 then
		FPS = fpsFrames
		fpsFrames = 0
		fpsTimer = 0
	end

	if CONFIG.Performance then
		local ping = 0

		pcall(function()
			ping = math.floor(
				LocalPlayer:GetNetworkPing() * 1000
			)
		end)

		FPSLabel.Text = "  FPS: " .. FPS
		PingLabel.Text = "  Ping: " .. ping .. " ms"
	else
		FPSLabel.Text = "  FPS: --"
		PingLabel.Text = "  Ping: --"
	end

	PlayersLabel.Text =
		"  Players: " .. #Players:GetPlayers()

	TargetLabel.Text =
		"  Training Dummies: " ..
		#GetTrainingTargets()

	-- Position / velocity
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if CONFIG.Coordinates and root then
		local position = root.Position
		local velocity = root.AssemblyLinearVelocity

		PositionLabel.Text = string.format(
			"  Position: %.1f, %.1f, %.1f",
			position.X,
			position.Y,
			position.Z
		)

		VelocityLabel.Text = string.format(
			"  Velocity: %.1f, %.1f, %.1f",
			velocity.X,
			velocity.Y,
			velocity.Z
		)
	else
		PositionLabel.Text = "  Position: --"
		VelocityLabel.Text = "  Velocity: --"
	end

	-- Player billboards
	for player, billboard in pairs(BillboardObjects) do
		if player.Parent and billboard.Parent then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if root then
				local label = billboard:FindFirstChildOfClass("TextLabel")

				if label then
					local parts = {}

					if CONFIG.ESPNames then
						table.insert(parts, player.DisplayName)
					end

					if CONFIG.ESPDistance then
						local myCharacter = LocalPlayer.Character
						local myRoot =
							myCharacter and
							myCharacter:FindFirstChild("HumanoidRootPart")

						if myRoot then
							local distance =
								(root.Position - myRoot.Position).Magnitude

							table.insert(
								parts,
								math.floor(distance) .. " studs"
							)
						end
					end

					label.Text = table.concat(parts, "  •  ")
				end
			end
		end
	end

	-- Training target lock
	if CONFIG.TrainingTargetLock then
		local target = FindClosestTrainingTarget()

		if target then
			local cameraPosition = Camera.CFrame.Position

			Camera.CFrame = CFrame.lookAt(
				cameraPosition,
				target.Position
			)
		end
	end

	-- Training aura
	UpdateTrainingAura()

	-- Freecam
	if Freecam.Active then
		local speed = Freecam.Speed

		if keys.Shift then
			speed *= 3
		end

		local movement = Vector3.zero

		if keys.W then
			movement += Vector3.new(0, 0, -1)
		end

		if keys.S then
			movement += Vector3.new(0, 0, 1)
		end

		if keys.A then
			movement += Vector3.new(-1, 0, 0)
		end

		if keys.D then
			movement += Vector3.new(1, 0, 0)
		end

		if keys.Space then
			movement += Vector3.new(0, 1, 0)
		end

		if keys.Ctrl then
			movement += Vector3.new(0, -1, 0)
		end

		if movement.Magnitude > 0 then
			movement = movement.Unit
		end

		local rotation =
			CFrame.Angles(
				Freecam.Rotation.X,
				Freecam.Rotation.Y,
				0
			)

		local moveVector =
			rotation:VectorToWorldSpace(movement)

		Freecam.Position +=
			moveVector * speed * dt

		Camera.CFrame =
			CFrame.new(Freecam.Position) *
			rotation
	end

	-- Keep FOV circle centered
	if FOVCircle then
		FOVCircle.Position = UDim2.fromScale(0.5, 0.5)
	end
end)

--=========================================================
-- CHARACTER RESPAWN SUPPORT
--=========================================================

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)

	if not Freecam.Active then
		Camera.CameraType = Enum.CameraType.Custom

		local character = LocalPlayer.Character
		local humanoid = character and
			character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			Camera.CameraSubject = humanoid
		end
	end

	if CONFIG.ESP then
		task.wait(0.2)
		RefreshESP()
	end
end)

--=========================================================
-- STARTUP
--=========================================================

Camera.FieldOfView = CONFIG.FOV

Notify(
	"Purple Admin Suite",
	"Loaded successfully. Press RightShift to toggle.",
	4
)
