Section(
	PlayersPage,
	"Player Inspector",
	"Select a player to spectate, inspect or teleport to."
)

local Search = New("TextBox", {
	Size = UDim2.new(1, -4, 0, 40),
	BackgroundColor3 = CFG.Panel2,
	BorderSizePixel = 0,
	PlaceholderText = "Search players...",
	PlaceholderColor3 = CFG.Muted,
	Text = "",
	TextColor3 = CFG.Text,
	Font = Enum.Font.Gotham,
	TextSize = 12,
	ClearTextOnFocus = false,
}, PlayersPage)

AddCorner(Search, 8)

local PlayerList = New("ScrollingFrame", {
	Size = UDim2.new(1, -4, 0, 170),
	BackgroundColor3 = CFG.Panel,
	BorderSizePixel = 0,
	ScrollBarThickness = 3,
	ScrollBarImageColor3 = CFG.Accent,
}, PlayersPage)

AddCorner(PlayerList, 8)

New("UIPadding", {
	PaddingTop = UDim.new(0, 6),
	PaddingLeft = UDim.new(0, 6),
	PaddingRight = UDim.new(0, 6),
	PaddingBottom = UDim.new(0, 6),
}, PlayerList)

New("UIListLayout", {
	Padding = UDim.new(0, 4),
}, PlayerList)

local SelectedPlayer
local SelectedInfo = Info(PlayersPage, "No player selected.")

local function RefreshPlayerList()
	for _, child in ipairs(PlayerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local query = string.lower(Search.Text)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if query == ""
				or string.find(
					string.lower(player.Name),
					query,
					1,
					true
				)
				or string.find(
					string.lower(player.DisplayName),
					query,
					1,
					true
				)
			then
				local button = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 34),
					BackgroundColor3 =
						SelectedPlayer == player
						and Color3.fromRGB(61, 38, 82)
						or CFG.Panel2,
					BorderSizePixel = 0,
					Text = "  " ..
						player.DisplayName ..
						"  @" ..
						player.Name,
					TextColor3 = CFG.Text,
					Font = Enum.Font.GothamSemibold,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, PlayerList)

				AddCorner(button, 6)

				button.MouseButton1Click:Connect(function()
					SelectedPlayer = player
					RefreshPlayerList()

					Notify(
						"Player Selected",
						player.DisplayName ..
							"  @" ..
							player.Name,
						2
					)
				end)
			end
		end
	end
end

Search:GetPropertyChangedSignal("Text"):Connect(RefreshPlayerList)

Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(RefreshPlayerList)

RefreshPlayerList()

RunService.RenderStepped:Connect(function()
	if SelectedPlayer and SelectedPlayer.Parent then
		local char = SelectedPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if hum then
			SelectedInfo.Text =
				"  " ..
				SelectedPlayer.DisplayName ..
				" | HP: " ..
				math.floor(hum.Health) ..
				" / " ..
				math.floor(hum.MaxHealth) ..
				" | Team: " ..
				(
					SelectedPlayer.Team
					and SelectedPlayer.Team.Name
					or "None"
				)
		end
	end
end)

Button(
	PlayersPage,
	"Inspect Selected",
	function()
		if not SelectedPlayer then
			Notify("Inspector", "Select a player first.", 2)
			return
		end

		local char = SelectedPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")

		print("========== PLAYER ==========")
		print("Name:", SelectedPlayer.Name)
		print("DisplayName:", SelectedPlayer.DisplayName)
		print("UserId:", SelectedPlayer.UserId)
		print("Team:",
			SelectedPlayer.Team and
			SelectedPlayer.Team.Name or
			"None"
		)

		if hum then
			print("Health:", hum.Health)
			print("MaxHealth:", hum.MaxHealth)
			print("WalkSpeed:", hum.WalkSpeed)
			print("JumpPower:", hum.JumpPower)
		end

		if root then
			print("Position:", root.Position)
		end

		print("============================")

		Notify(
			"Inspector",
			"Information printed to Developer Console.",
			3
		)
	end
)

Button(
	PlayersPage,
	"Spectate Selected",
	function()
		if not SelectedPlayer then
			Notify("Spectate", "Select a player first.", 2)
			return
		end

		local char = SelectedPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if hum then
			Camera.CameraSubject = hum
			CFG.Spectating = true

			Notify(
				"Spectate",
				"Now spectating " .. SelectedPlayer.Name,
				2
			)
		end
	end
)

Button(
	PlayersPage,
	"Stop Spectating",
	function()
		UpdateCharacter()

		if Humanoid then
			Camera.CameraSubject = Humanoid
		end

		CFG.Spectating = false
	end
)

Button(
	PlayersPage,
	"Teleport To Selected",
	function()
		if not SelectedPlayer then
			Notify("Teleport", "Select a player first.", 2)
			return
		end

		UpdateCharacter()

		local targetChar = SelectedPlayer.Character
		local targetRoot =
			targetChar and
			targetChar:FindFirstChild("HumanoidRootPart")

		if Root and targetRoot then
			Root.CFrame =
				targetRoot.CFrame *
				CFrame.new(0, 0, -4)

			Notify(
				"Teleport",
				"Teleported to " .. SelectedPlayer.Name,
				2
			)
		end
	end
)

