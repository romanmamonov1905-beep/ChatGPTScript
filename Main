Toggle(
	PowerPage,
	"ForceField",
	false,
	function(value)
		CFG.ForceField = value

		UpdateCharacter()

		if value and Character then
			if not Character:FindFirstChild("PurpleAdminForceField") then
				local ff = Instance.new("ForceField")
				ff.Name = "PurpleAdminForceField"
				ff.Parent = Character
			end
		elseif Character then
			local ff =
				Character:FindFirstChild(
					"PurpleAdminForceField"
				)

			if ff then
				ff:Destroy()
			end
		end
	end
)

--=========================================================
-- AIM LOCK
--=========================================================

Section(
	PowerPage,
	"Aim Lock",
	"Local camera aim assistance for testing."
)

local function FindNearestTarget()
	local nearest
	local nearestDistance = math.huge

	local center =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local hum =
				char and
				char:FindFirstChildOfClass("Humanoid")

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if root and hum and hum.Health > 0 then
				local screen, visible =
					Camera:WorldToViewportPoint(
						root.Position
					)

				if visible then
					local screenVector =
						Vector2.new(
							screen.X,
							screen.Y
						)

					local distance =
						(screenVector - center).Magnitude

					if distance <= CFG.AimFOV
						and distance < nearestDistance then

						nearestDistance = distance
						nearest = player
					end
				end
			end
		end
	end

	return nearest
end

Toggle(
	PowerPage,
	"Aim Lock",
	false,
	function(value)
		CFG.AimLock = value

		Notify(
			"Aim Lock",
			value
				and "Nearest visible player within FOV."
				or "Aim Lock disabled.",
			2
		)
	end
)

Info(
