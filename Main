local function Section(parent, title, subtitle)
	local box = New("Frame", {
		Size = UDim2.new(1, -4, 0, 60),
		BackgroundColor3 = CFG.Panel,
		BorderSizePixel = 0,
	}, parent)

	AddCorner(box, 9)

	New("TextLabel", {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.new(0, 12, 0, 7),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = CFG.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, box)

	New("TextLabel", {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.new(0, 12, 0, 30),
		BackgroundTransparency = 1,
		Text = subtitle or "",
		TextColor3 = CFG.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, box)

	return box
end

local function Info(parent, text)
	local box = New("TextLabel", {
		Size = UDim2.new(1, -4, 0, 40),
		BackgroundColor3 = CFG.Panel,
		BorderSizePixel = 0,
		Text = "  " .. text,
		TextColor3 = CFG.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
	}, parent)

	AddCorner(box, 8)

	return box
end

local function Button(parent, text, callback)
	local button = New("TextButton", {
		Size = UDim2.new(1, -4, 0, 42),
		BackgroundColor3 = CFG.Panel2,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = CFG.Text,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		AutoButtonColor = false,
	}, parent)

	AddCorner(button, 8)
	AddStroke(button, Color3.fromRGB(58, 45, 72), 1)

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = CFG.Panel3,
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = CFG.Panel2,
		}, 0.12)
	end)

	button.MouseButton1Click:Connect(function()
		callback(button)
	end)

	return button
end

local function Toggle(parent, text, default, callback)
	local state = default or false

	local button = New("TextButton", {
		Size = UDim2.new(1, -4, 0, 42),
		BackgroundColor3 = CFG.Panel2,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, parent)

	AddCorner(button, 8)

	New("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.new(0, 13, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = CFG.Text,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, button)

	local switch = New("Frame", {
		Size = UDim2.new(0, 40, 0, 22),
		Position = UDim2.new(1, -52, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(55, 46, 65),
		BorderSizePixel = 0,
	}, button)

	AddCorner(switch, 20)

	local knob = New("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(0, 3, 0.5, -8),
		BackgroundColor3 = CFG.Text,
		BorderSizePixel = 0,
	}, switch)

	AddCorner(knob, 20)

	local function Update()
		if state then
			Tween(switch, {
				BackgroundColor3 = CFG.Accent,
			}, 0.15)

			Tween(knob, {
				Position = UDim2.new(1, -19, 0.5, -8),
			}, 0.15)
		else
			Tween(switch, {
				BackgroundColor3 = Color3.fromRGB(55, 46, 65),
			}, 0.15)

			Tween(knob, {
				Position = UDim2.new(0, 3, 0.5, -8),
			}, 0.15)
		end

		callback(state)
	end

	button.MouseButton1Click:Connect(function()
		state = not state
		Update()
	end)

	Update()

	return {
		Set = function(_, value)
			state = value
			Update()
		end,

		Get = function()
			return state
		end
	}
end

