local function Section(parent, title, description)
	local box = New("Frame", {
		Size = UDim2.new(1, -4, 0, 62),
		BackgroundColor3 = CONFIG.Panel,
		BorderSizePixel = 0,
	}, parent)

	Corner(box, 9)

	New("TextLabel", {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.new(0, 12, 0, 8),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, box)

	New("TextLabel", {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.new(0, 12, 0, 31),
		BackgroundTransparency = 1,
		Text = description or "",
		TextColor3 = CONFIG.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, box)

	return box
end

local function Button(parent, text, callback, color)
	local button = New("TextButton", {
		Size = UDim2.new(1, -4, 0, 42),
		BackgroundColor3 = CONFIG.Panel2,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		AutoButtonColor = false,
	}, parent)

	Corner(button, 8)
	Stroke(button, Color3.fromRGB(58, 45, 72), 1)

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = color or Color3.fromRGB(49, 34, 63)
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = CONFIG.Panel2
		}, 0.12)
	end)

	button.MouseButton1Click:Connect(function()
		if callback then
			callback(button)
		end
	end)

	return button
end

local function Toggle(parent, text, default, callback)
	local value = default or false

	local button = New("TextButton", {
		Size = UDim2.new(1, -4, 0, 42),
		BackgroundColor3 = CONFIG.Panel2,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, parent)

	Corner(button, 8)

	local label = New("TextLabel", {
		Size = UDim2.new(1, -72, 1, 0),
		Position = UDim2.new(0, 13, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, button)

	local switch = New("Frame", {
		Size = UDim2.new(0, 42, 0, 22),
		Position = UDim2.new(1, -53, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(54, 45, 64),
		BorderSizePixel = 0,
	}, button)

	Corner(switch, 20)

	local knob = New("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(0, 3, 0.5, -8),
		BackgroundColor3 = CONFIG.Text,
		BorderSizePixel = 0,
	}, switch)

	Corner(knob, 20)

	local function Update()
		if value then
			Tween(switch, {BackgroundColor3 = CONFIG.Accent}, 0.15)
			Tween(knob, {
				Position = UDim2.new(1, -19, 0.5, -8)
			}, 0.15)
		else
			Tween(switch, {
				BackgroundColor3 = Color3.fromRGB(54, 45, 64)
			}, 0.15)

			Tween(knob, {
				Position = UDim2.new(0, 3, 0.5, -8)
			}, 0.15)
		end

		if callback then
			callback(value)
		end
	end

	button.MouseButton1Click:Connect(function()
		value = not value
		Update()
	end)

	Update()

	return {
		Object = button,

		Set = function(_, newValue)
			value = newValue
			Update()
		end,

		Get = function()
			return value
		end
	}
end

local function Info(parent, text)
	local box = New("TextLabel", {
		Size = UDim2.new(1, -4, 0, 42),
		BackgroundColor3 = CONFIG.Panel,
		BorderSizePixel = 0,
		Text = "  " .. text,
		TextColor3 = CONFIG.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)

	Corner(box, 8)

	return box
end

--=========================================================
-- ESP SYSTEM
--=========================================================

local Highlights = {}
local BillboardObjects = {}

local function ClearPlayerVisual(player)
	if Highlights[player] then
		Highlights[player]:Destroy()
		Highlights[player] = nil
	end

	if BillboardObjects[player] then
		BillboardObjects[player]:Destroy()
		BillboardObjects[player] = nil
	end
end

local function CreatePlayerVisual(player)
	if player == LocalPlayer then
		return
	end

	local char = player.Character

	if not char then
		return
	end

	ClearPlayerVisual(player)

	if CONFIG.ESP then
		local h = Instance.new("Highlight")
		h.Name = "AdminESP"
		h.FillColor = CONFIG.Accent
		h.OutlineColor = CONFIG.Text
		h.FillTransparency = 0.7
		h.OutlineTransparency = 0.05
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Adornee = char
		h.Parent = char

		Highlights[player] = h
	end

	if CONFIG.ESPNames or CONFIG.ESPDistance then
		local root = char:FindFirstChild("HumanoidRootPart")

		if root then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "AdminPlayerInfo"
			billboard.Size = UDim2.new(0, 180, 0, 50)
			billboard.StudsOffset = Vector3.new(0, 3.2, 0)
			billboard.AlwaysOnTop = true
			billboard.Adornee = root
			billboard.Parent = root

			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextColor3 = CONFIG.Text
			label.TextStrokeTransparency = 0.4
			label.Font = Enum.Font.GothamBold
			label.TextSize = 12
			label.Parent = billboard

			BillboardObjects[player] = billboard
		end
	end
end

local function RefreshESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			CreatePlayerVisual(player)
		end
	end
end

local function RemoveAllESP()
	for _, player in ipairs(Players:GetPlayers()) do
		ClearPlayerVisual(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		CreatePlayerVisual(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	ClearPlayerVisual(player)
end)

