-- ПОЛНОСТЬЮ ЛОКАЛЬНЫЙ АДМИН-СКРИПТ (LocalScript в StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Ждем загрузки интерфейса игрока
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- 1. СОЗДАНИЕ ИНТЕРФЕЙСА (GUI)
----------------------------------------------------------------
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LocalAdminPanel"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- Главный фрейм панели
local MainFrame = Instance.new("Frame")
MainFrame.Size = UUDim2.new(0, 250, 0, 300)
MainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true -- Позволяет перетаскивать панель мышкой
MainFrame.Parent = ScreenGui

-- Закругление углов панели
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

-- Заголовок панели
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "LOCAL ADMIN PANEL"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18
Title.Parent = MainFrame

-- Список для кнопок (автоматическое выравнивание)
local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 10)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Parent = MainFrame

-- Вспомогательная функция для создания красивых кнопок
local function createButton(text, layoutOrder)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 210, 0, 40)
	button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.SourceSans
	button.TextSize = 16
	button.LayoutOrder = layoutOrder
	button.Parent = MainFrame
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = button
	
	return button
end

local EspButton = createButton("Toggle ESP: OFF", 1)
local FlyButton = createButton("Toggle Fly: OFF", 2)
local SpeedButton = createButton("Speed Boost (WalkSpeed)", 3)

-- Подсказка управления внизу панели
local Footer = Instance.new("TextLabel")
Footer.Size = UDim2.new(1, 0, 0, 30)
Footer.BackgroundTransparency = 1
Footer.Text = "Press 'P' to Hide/Show"
Footer.TextColor3 = Color3.fromRGB(150, 150, 150)
Footer.Font = Enum.Font.SourceSansItalic
Footer.TextSize = 14
Footer.LayoutOrder = 4
Footer.Parent = MainFrame

----------------------------------------------------------------
-- 2. РЕАЛИЗАЦИЯ ФУНКЦИЙ (ESP, FLY, SPEED)
----------------------------------------------------------------

-- [ФУНКЦИЯ 1: ESP (Подсветка игроков)]
local espEnabled = false
local espConnections = {}

local function createESP(player)
	if player == LocalPlayer then return end
	
	local function addHighlight(character)
		if character:FindFirstChild("ESPHighlight") then return end
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESPHighlight"
		highlight.FillColor = Color3.fromRGB(255, 0, 0)
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineTransparency = 0
		highlight.Adornee = character
		highlight.Parent = character
	end
	
	if player.Character then addHighlight(player.Character) end
	local conn = player.CharacterAdded:Connect(addHighlight)
	table.insert(espConnections, conn)
end

EspButton.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	if espEnabled then
		EspButton.Text = "Toggle ESP: ON"
		EspButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
		-- Включаем ESP для текущих игроков
		for _, player in ipairs(Players:GetPlayers()) do
			createESP(player)
		end
		-- Следим за новыми игроками
		local joinConn = Players.PlayerAdded:Connect(createESP)
		table.insert(espConnections, joinConn)
	else
		EspButton.Text = "Toggle ESP: OFF"
		EspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		-- Очищаем все соединения и подсветки
		for _, conn in ipairs(espConnections) do conn:Disconnect() end
		table.clear(espConnections)
		
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and player.Character:FindFirstChild("ESPHighlight") then
				player.Character.ESPHighlight:Destroy()
			end
		end
	end
end)


-- [ФУНКЦИЯ 2: FLY (Локальный Полет)]
local flyEnabled = false
local flyConnection = nil
local flySpeed = 50

FlyButton.MouseButton1Click:Connect(function()
	flyEnabled = not flyEnabled
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then return end
	
	if flyEnabled then
		FlyButton.Text = "Toggle Fly: ON"
		FlyButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
		
		-- Создаем локальные силы для удержания в воздухе
		local bv = Instance.new("BodyVelocity")
		bv.Name = "FlyVelocity"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.Parent = hrp
		
		humanoid.PlatformStand = true -- Отключаем физику падения анимаций
		
		-- Цикл управления полетом при помощи камеры
		flyConnection = RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			local moveDirection = humanoid.MoveDirection
			
			-- Куда смотрит камера, туда и летим
			if moveDirection.Magnitude > 0 then
				bv.Velocity = camera.CFrame.LookVector * (moveDirection.Magnitude * flySpeed)
			else
				bv.Velocity = Vector3.new(0, 0, 0)
			end
		end)
	else
		FlyButton.Text = "Toggle Fly: OFF"
		FlyButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		
		if flyConnection then flyConnection:Disconnect() flyConnection = nil end
		if hrp:FindFirstChild("FlyVelocity") then hrp.FlyVelocity:Destroy() end
		if humanoid then humanoid.PlatformStand = false end
	end
end)


-- [ФУНКЦИЯ 3: SPEED (Скорость бега)]
local speedBoosted = false
SpeedButton.MouseButton1Click:Connect(function()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	speedBoosted = not speedBoosted
	if speedBoosted then
		humanoid.WalkSpeed = 100 -- Ваша новая скорость бега
		SpeedButton.Text = "Speed Boost: 100"
		SpeedButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
	else
		humanoid.WalkSpeed = 16 -- Стандартная скорость Roblox
		SpeedButton.Text = "Speed Boost (WalkSpeed)"
		SpeedButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	end
end)

-- Обновление скорости и состояния полета при спавне (если персонаж погиб)
LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(1)
	if speedBoosted then
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then hum.WalkSpeed = 100 end
	end
	if flyEnabled then
		-- Сбрасываем кнопку полета, так как старое тело уничтожено
		flyEnabled = false
		FlyButton.Text = "Toggle Fly: OFF"
		FlyButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		if flyConnection then flyConnection:Disconnect() end
	end
end)


----------------------------------------------------------------
-- 3. СКРЫТИЕ И ОТКРЫТИЕ ПАНЕЛИ КЛАВИШЕЙ
----------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then return end -- Игнорируем нажатия, если игрок пишет в чат
	if input.KeyCode == Enum.KeyCode.P then
		MainFrame.Visible = not MainFrame.Visible
	end
end)
