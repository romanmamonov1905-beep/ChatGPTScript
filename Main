--=========================================================
-- DRAG WINDOW
--=========================================================

local Dragging = false
local DragStart
local StartPosition

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = true
		DragStart = input.Position
		StartPosition = Main.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not Dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		local delta =
			input.Position - DragStart

		Main.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + delta.Y
		)
	end
end)

--=========================================================
-- OPEN / CLOSE
--=========================================================

local MenuOpen = true

local function SetMenu(value)
	MenuOpen = value
	Main.Visible = value
end

CloseButton.MouseButton1Click:Connect(function()
	SetMenu(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == CFG.Key then
		SetMenu(not MenuOpen)
	end

	if input.KeyCode == Enum.KeyCode.F6 then
		StopFreecam()
	end
end)

--=========================================================
-- RENDER LOOP
--=========================================================

local fpsFrames = 0
local fpsTime = 0
local fps = 60

RunService.RenderStepped:Connect(function(dt)

	-- FPS
	fpsFrames += 1
	fpsTime += dt

	if fpsTime >= 1 then
		fps = fpsFrames
		fpsFrames = 0
		fpsTime = 0
	end

	--=====================================================
	-- NOCLIP
	--=====================================================

	if CFG.Noclip then
		UpdateCharacter()

		if Character then
			for _, obj in ipairs(
				Character:GetDescendants()
			) do
				if obj:IsA("BasePart") then
					if OriginalCollision[obj] == nil then
						OriginalCollision[obj] =
							obj.CanCollide
					end

					obj.CanCollide = false
				end
			end
		end
	end

	--=====================================================
	-- FLY
	--=====================================================

	if CFG.Fly
		and FlyVelocity
		and Root then

		local direction = Vector3.zero

		if FlyKeys.W then
			direction += Camera.CFrame.LookVector
		end

		if FlyKeys.S then
			direction -= Camera.CFrame.LookVector
		end

		if FlyKeys.A then
			direction -= Camera.CFrame.RightVector
		end

		if FlyKeys.D then
			direction += Camera.CFrame.RightVector
		end

		if FlyKeys.Up then
			direction += Vector3.yAxis
		end

		if FlyKeys.Down then
			direction -= Vector3.yAxis
		end

		if direction.Magnitude > 0 then
			direction = direction.Unit
		end

		local speed = CFG.FlySpeed

		if FlyKeys.Shift then
			speed *= 3
		end

		FlyVelocity.Velocity =
			direction * speed

		if FlyGyro then
			FlyGyro.CFrame = Camera.CFrame
		end
	end

	--=====================================================
	-- AIM LOCK
	--=====================================================

	if CFG.AimLock then
		local target = FindNearestTarget()

		if target then
			local char = target.Character
			local targetRoot =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then
				Camera.CFrame =
					CFrame.lookAt(
						Camera.CFrame.Position,
						targetRoot.Position
					)
			end
		end
	end

	--=====================================================
	-- TRAINING AURA
	--=====================================================

	if CFG.TrainingAura then
		UpdateCharacter()

		if Root then
			for _, dummy in ipairs(
				GetTrainingDummies()
			) do
				local dummyHum =
					dummy:FindFirstChildOfClass(
						"Humanoid"
					)

				local dummyRoot =
					dummy:FindFirstChild(
						"HumanoidRootPart"
					)

				if dummyHum and dummyRoot then
					local distance =
						(
							dummyRoot.Position -
							Root.Position
						).Magnitude

					if distance <= 12
						and dummyHum.Health > 0 then

						-- Local-only training effect.
						dummyHum.Health =
							math.max(
								0,
								dummyHum.Health - 10
							)
					end
				end
			end
		end
	end

	--=====================================================
	-- PLAYER TAGS
	--=====================================================

	for player, billboard in pairs(NameTags) do
		if player.Parent
			and billboard.Parent then

			local char = player.Character
			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if root then
				local label =
					billboard:FindFirstChildOfClass(
						"TextLabel"
					)

				if label then
					local text = {}

					if CFG.ESPNames then
						table.insert(
							text,
							player.DisplayName
						)
					end

					if CFG.ESPDistance then
						UpdateCharacter()

						if Root then
							local distance =
								(
									root.Position -
									Root.Position
								).Magnitude

							table.insert(
								text,
								math.floor(distance)
									.. " studs"
							)
						end
					end

					label.Text =
						table.concat(
							text,
							"  •  "
						)
				end
			end
		end
	end

	--=====================================================
	-- FREECAM
	--=====================================================

	if Freecam.Active then
		local move = Vector3.zero

		if FlyKeys.W then
			move += Vector3.new(0, 0, -1)
		end

		if FlyKeys.S then
			move += Vector3.new(0, 0, 1)
		end

		if FlyKeys.A then
			move += Vector3.new(-1, 0, 0)
		end

		if FlyKeys.D then
			move += Vector3.new(1, 0, 0)
		end

		if FlyKeys.Up then
			move += Vector3.yAxis
		end

		if FlyKeys.Down then
			move -= Vector3.yAxis
		end

		if move.Magnitude > 0 then
			move = move.Unit
		end

		local rotation =
			CFrame.Angles(
				Freecam.Rotation.X,
				Freecam.Rotation.Y,
				0
			)

		local worldMove =
			rotation:VectorToWorldSpace(
				move
			)

		local speed =
			Freecam.Speed

		if FlyKeys.Shift then
			speed *= 3
		end

		Freecam.Position +=
			worldMove *
			speed *
			dt

		Camera.CFrame =
			CFrame.new(
				Freecam.Position
			) *
			rotation
	end

	--=====================================================
	-- DEBUG HUD
	--=====================================================

	if ShowDebug then
		local ping = 0

		pcall(function()
			ping =
				math.floor(
					LocalPlayer:GetNetworkPing()
						* 1000
				)
		end)

		FPSLabel.Text =
			"  FPS: " .. fps

		PingLabel.Text =
			"  Ping: " .. ping .. " ms"
	else
		FPSLabel.Text = "  FPS: --"
		PingLabel.Text = "  Ping: --"
	end

	PlayersLabel.Text =
		"  Players: " ..
		#Players:GetPlayers()

	DummyLabel.Text =
		"  Training Dummies: " ..
		#GetTrainingDummies()

	if ShowCoords then
		UpdateCharacter()

		if Root then
			local pos = Root.Position
			local vel = Root.AssemblyLinearVelocity

			PositionLabel.Text =
				string.format(
					"  Position: %.1f, %.1f, %.1f",
					pos.X,
					pos.Y,
					pos.Z
				)

			VelocityLabel.Text =
				string.format(
					"  Velocity: %.1f, %.1f, %.1f",
					vel.X,
					vel.Y,
					vel.Z
				)
		end
	else
		PositionLabel.Text = "  Position: --"
		VelocityLabel.Text = "  Velocity: --"
	end

	-- FOV circle
	FOVCircle.Size =
		UDim2.fromOffset(
			CFG.AimFOV * 2,
			CFG.AimFOV * 2
		)

	FOVCircle.Position =
		UDim2.fromScale(0.5, 0.5)
end)

--=========================================================
-- PLAYER CHARACTER UPDATES
--=========================================================

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)

		if CFG.ESP
			or CFG.ESPNames
			or CFG.ESPDistance then

			ApplyESP(player)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	RemoveESP(player)
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)

	if CFG.Speed and Humanoid then
		Humanoid.WalkSpeed = 60
	end

	if CFG.SuperJump and Humanoid then
		Humanoid.UseJumpPower = true
		Humanoid.JumpPower = 120
	end
end)

--=========================================================
-- STARTUP
--=========================================================

Camera.FieldOfView = CFG.FOV

Notify(
	"Purple Admin Suite",
	"Loaded. RightShift = open/close.",
	4
)
```
