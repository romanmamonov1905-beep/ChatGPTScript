	VisualPage,
	"Player Names",
	false,
	function(value)
		CONFIG.ESPNames = value
		RefreshESP()
	end
)

Toggle(
	VisualPage,
	"Player Distance",
	false,
	function(value)
		CONFIG.ESPDistance = value
		RefreshESP()
	end
)

