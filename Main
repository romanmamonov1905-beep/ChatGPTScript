local function GetTrainingDummies()
	local targets = {}

	for _, obj in ipairs(
		CollectionService:GetTagged("TrainingDummy")
	) do
		if obj:IsA("Model") then
			local hum =
				obj:FindFirstChildOfClass("Humanoid")

			local root =
				obj:FindFirstChild("HumanoidRootPart")

			if hum and root and hum.Health > 0 then
				table.insert(targets, obj)
			end
		end
	end

	return targets
end

--=========================================================
-- ESP
--=========================================================

Section(
	VisualPage,
	"ESP",
	"Local player highlighting."
)

local Highlights = {}
local NameTags = {}

local function RemoveESP(player)
	if Highlights[player] then
		Highlights[player]:Destroy()
		Highlights[player] = nil
	end

	if NameTags[player] then
		NameTags[player]:Destroy()
		NameTags[player] = nil
	end
end

local function ApplyESP(player)
	if player == LocalPlayer then
		return
	end

	local char = player.Character

	if not char then
		return
	end

	RemoveESP(player)

	if CFG.ESP then
		local highlight = Instance.new("Highlight")
		highlight.Name = "PurpleAdminESP"
		highlight.FillColor = CFG.Accent
		highlight.OutlineColor = CFG.Text
		highlight.FillTransparency = 0.7
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = char
		highlight.Parent = char

		Highlights[player] = highlight
	end

	if CFG.ESPNames or CFG.ESPDistance then
		local root =
			char:FindFirstChild(
				"HumanoidRootPart"
			)

		if root then
			local billboard =
				Instance.new("BillboardGui")

			billboard.Name = "PurpleAdminName"
			billboard.Size =
				UDim2.new(0, 200, 0, 50)

			billboard.StudsOffset =
				Vector3.new(0, 3, 0)

			billboard.AlwaysOnTop = true
			billboard.Adornee = root
			billboard.Parent = root

			local label =
				Instance.new("TextLabel")

			label.Size =
				UDim2.fromScale(1, 1)

			label.BackgroundTransparency = 1
			label.TextColor3 = CFG.Text
			label.TextStrokeTransparency = 0.3
			label.Font = Enum.Font.GothamBold
			label.TextSize = 12
			label.Parent = billboard

			NameTags[player] = billboard
		end
	end
end

local function RefreshESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			ApplyESP(player)
		end
	end
end

local function ClearESP()
	for player in pairs(Highlights) do
		RemoveESP(player)
	end

	for player in pairs(NameTags) do
		RemoveESP(player)
	end
end

Toggle(
	VisualPage,
	"Player ESP",
	false,
	function(value)
		CFG.ESP = value

		if value then
			RefreshESP()
		else
			ClearESP()
		end
	end
)

Toggle(
	VisualPage,
	"Player Names",
	false,
	function(value)
		CFG.ESPNames = value
		RefreshESP()
	end
)

Toggle(
	VisualPage,
	"Player Distance",
	false,
	function(value)
		CFG.ESPDistance = value
		RefreshESP()
	end
)

