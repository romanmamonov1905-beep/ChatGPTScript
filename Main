--=========================================================
-- TRAINING TARGET SYSTEM
--=========================================================

Section(
	VisualPage,
	"Training Mode",
	"Works only with NPC models tagged 'TrainingDummy'."
)

local function GetTrainingTargets()
	local result = {}

	for _, object in ipairs(CollectionService:GetTagged("TrainingDummy")) do
		if object:IsA("Model") then
			local humanoid = object:FindFirstChildOfClass("Humanoid")
			local root = object:FindFirstChild("HumanoidRootPart")

			if humanoid and root and humanoid.Health > 0 then
				table.insert(result, object)
			end
		end
	end

	return result
end

