	PowerPage,
	"Movement Powers",
	"Local movement/debug controls."
)

Toggle(
	PowerPage,
	"Super Speed",
	false,
	function(value)
		CFG.Speed = value

		UpdateCharacter()

		if Humanoid then
			Humanoid.WalkSpeed =
				value and 60 or 16
		end
	end
)

Toggle(
	PowerPage,
	"Super Jump",
	false,
	function(value)
		CFG.SuperJump = value

		UpdateCharacter()

		if Humanoid then
			Humanoid.UseJumpPower = true
			Humanoid.JumpPower =
				value and 120 or 50
		end
	end
)

Toggle(
	PowerPage,
	"Infinite Jump",
	false,
	function(value)
		CFG.InfiniteJump = value
	end
)

UserInputService.JumpRequest:Connect(function()
	if CFG.InfiniteJump then
		UpdateCharacter()

		if Humanoid then
			Humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)
		end
	end
end)

--=========================================================
-- FLY
--=========================================================

local FlyVelocity
local FlyGyro

local FlyKeys = {
	W = false,
	A = false,
	S = false,
	D = false,
	Up = false,
	Down = false,
	Shift = false,
}

local FlyKeyMap = {
	[Enum.KeyCode.W] = "W",
	[Enum.KeyCode.A] = "A",
	[Enum.KeyCode.S] = "S",
	[Enum.KeyCode.D] = "D",
	[Enum.KeyCode.Space] = "Up",
	[Enum.KeyCode.LeftControl] = "Down",
	[Enum.KeyCode.LeftShift] = "Shift",
}

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	local key = FlyKeyMap[input.KeyCode]

	if key then
		FlyKeys[key] = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local key = FlyKeyMap[input.KeyCode]

	if key then
		FlyKeys[key] = false
	end
end)

local function StartFly()
	UpdateCharacter()

	if not Root then
		return
	end

	if FlyVelocity then
		FlyVelocity:Destroy()
	end

	if FlyGyro then
		FlyGyro:Destroy()
	end

	FlyVelocity = Instance.new("BodyVelocity")
	FlyVelocity.Name = "PurpleAdminFlyVelocity"
	FlyVelocity.MaxForce =
		Vector3.new(math.huge, math.huge, math.huge)
	FlyVelocity.P = 10000
	FlyVelocity.Velocity = Vector3.zero
	FlyVelocity.Parent = Root

	FlyGyro = Instance.new("BodyGyro")
	FlyGyro.Name = "PurpleAdminFlyGyro"
	FlyGyro.MaxTorque =
		Vector3.new(math.huge, math.huge, math.huge)
	FlyGyro.P = 10000
	FlyGyro.CFrame = Root.CFrame
	FlyGyro.Parent = Root

	if Humanoid then
		Humanoid.PlatformStand = true
	end
end

local function StopFly()
	if FlyVelocity then
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyGyro then
		FlyGyro:Destroy()
		FlyGyro = nil
	end

	UpdateCharacter()

	if Humanoid then
		Humanoid.PlatformStand = false
	end
end

Toggle(
	PowerPage,
	"Fly",
	false,
	function(value)
		CFG.Fly = value

		if value then
			StartFly()

			Notify(
				"Fly",
				"WASD + Space + Ctrl | Shift = boost",
				3
			)
		else
			StopFly()
		end
	end
)

Button(
	PowerPage,
