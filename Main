--// Дополнительные безопасные Admin/Debug функции
--// Добавь этот блок ПОСЛЕ создания Content/Grid

local CollectionService = game:GetService("CollectionService")

local TARGET_LOCK = false
local DEBUG_AURA = false
local SPECTATING = false
local SPECTATE_INDEX = 1

local function GetTrainingTargets()
	local targets = {}

	for _, obj in ipairs(CollectionService:GetTagged("TrainingDummy")) do
		if obj:IsA("Model") then
			local humanoid = obj:FindFirstChildOfClass("Humanoid")
			local root = obj:FindFirstChild("HumanoidRootPart")

			if humanoid and root and humanoid.Health > 0 then
				table.insert(targets, obj)
			end
		end
	end

	return targets
end

--==================================================
-- TARGET LOCK (ТОЛЬКО TrainingDummy)
--==================================================

local TargetLockButton = CreateButton("Target Lock : OFF")

TargetLockButton.MouseButton1Click:Connect(function()
	TARGET_LOCK = not TARGET_LOCK

	if TARGET_LOCK then
		TargetLockButton.Text = "Target Lock : ON"
		TargetLockButton.TextColor3 = GREEN
	else
		TargetLockButton.Text = "Target Lock : OFF"
		TargetLockButton.TextColor3 = LIGHT
	end
end)

RunService.RenderStepped:Connect(function()
	if not TARGET_LOCK then
		return
	end

	local Camera = workspace.CurrentCamera
	local targets = GetTrainingTargets()

	local closest
	local closestDistance = math.huge

	for _, target in ipairs(targets) do
		local root = target:FindFirstChild("HumanoidRootPart")

		if root then
			local screenPos, visible =
				Camera:WorldToViewportPoint(root.Position)

			if visible then
				local center = Vector2.new(
					Camera.ViewportSize.X / 2,
					Camera.ViewportSize.Y / 2
				)

				local distance = (
					Vector2.new(screenPos.X, screenPos.Y) - center
				).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closest = root
				end
			end
		end
	end

	-- Только визуальная фиксация камеры,
	-- без атаки игроков и без изменения их здоровья.
	if closest then
		local cameraPosition = Camera.CFrame.Position
		Camera.CFrame = CFrame.lookAt(
			cameraPosition,
			closest.Position
		)
	end
end)

--==================================================
-- DEBUG AURA
-- Только подсветка TrainingDummy
--==================================================

local AuraButton = CreateButton("Training Aura : OFF")

AuraButton.MouseButton1Click:Connect(function()
	DEBUG_AURA = not DEBUG_AURA

	AuraButton.Text =
		DEBUG_AURA
		and "Training Aura : ON"
		or "Training Aura : OFF"

	AuraButton.TextColor3 =
		DEBUG_AURA and GREEN or LIGHT

	if not DEBUG_AURA then
		for _, obj in ipairs(CollectionService:GetTagged("TrainingDummy")) do
			local highlight = obj:FindFirstChild("TrainingAuraHighlight")

			if highlight then
				highlight:Destroy()
			end
		end
	end
end)

RunService.Heartbeat:Connect(function()
	if not DEBUG_AURA then
		return
	end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	for _, dummy in ipairs(GetTrainingTargets()) do
		local dummyRoot = dummy:FindFirstChild("HumanoidRootPart")

		if dummyRoot then
			local distance = (dummyRoot.Position - root.Position).Magnitude

			local highlight =
				dummy:FindFirstChild("TrainingAuraHighlight")

			if distance <= 20 then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "TrainingAuraHighlight"
					highlight.FillColor = PURPLE
					highlight.OutlineColor = LIGHT
					highlight.FillTransparency = 0.5
					highlight.DepthMode =
						Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = dummy
				end
			elseif highlight then
				highlight:Destroy()
			end
		end
	end
end)

--==================================================
-- SPECTATE
--==================================================

local SpectateButton = CreateButton("Spectate Players")

local function GetOtherPlayers()
	local result = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(result, player)
		end
	end

	return result
end

local function SpectateNext()
	local list = GetOtherPlayers()

	if #list == 0 then
		return
	end

	if SPECTATE_INDEX > #list then
		SPECTATE_INDEX = 1
	end

	local target = list[SPECTATE_INDEX]
	local character = target.Character
	local humanoid = character and
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		workspace.CurrentCamera.CameraSubject = humanoid
		SPECTATING = true
	end

	SPECTATE_INDEX += 1

	if SPECTATE_INDEX > #list then
		SPECTATE_INDEX = 1
	end
end

SpectateButton.MouseButton1Click:Connect(SpectateNext)

--==================================================
-- STOP SPECTATE
--==================================================

local StopSpectateButton = CreateButton("Stop Spectating")

StopSpectateButton.MouseButton1Click:Connect(function()
	local character = LocalPlayer.Character
	local humanoid = character and
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		workspace.CurrentCamera.CameraSubject = humanoid
	end

	SPECTATING = false
end)

--==================================================
-- FOV VISUALIZER
--==================================================

local FOV_ENABLED = false
local FOV_RADIUS = 150

local FOVButton = CreateButton("FOV Circle : OFF")

local FOVCircle = Instance.new("Frame")
FOVCircle.Name = "FOVCircle"
FOVCircle.Size = UDim2.fromOffset(
	FOV_RADIUS * 2,
	FOV_RADIUS * 2
)
FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
FOVCircle.Position = UDim2.fromScale(0.5, 0.5)
FOVCircle.BackgroundTransparency = 1
FOVCircle.Visible = false
FOVCircle.Parent = ScreenGui

local FOVCorner = Instance.new("UICorner")
FOVCorner.CornerRadius = UDim.new(1, 0)
FOVCorner.Parent = FOVCircle

local FOVStroke = Instance.new("UIStroke")
FOVStroke.Color = PURPLE
FOVStroke.Thickness = 2
FOVStroke.Transparency = 0.15
FOVStroke.Parent = FOVCircle

FOVButton.MouseButton1Click:Connect(function()
	FOV_ENABLED = not FOV_ENABLED
	FOVCircle.Visible = FOV_ENABLED

	FOVButton.Text =
		FOV_ENABLED
		and "FOV Circle : ON"
		or "FOV Circle : OFF"

	FOVButton.TextColor3 =
		FOV_ENABLED and GREEN or LIGHT
end)

--==================================================
-- PLAYER COUNT
--==================================================

local PlayerCountButton = CreateButton("Refresh Player Count")

PlayerCountButton.MouseButton1Click:Connect(function()
	PlayerCountButton.Text =
		"Players Online: " .. tostring(#Players:GetPlayers())

	task.delay(2, function()
		if PlayerCountButton.Parent then
			PlayerCountButton.Text = "Refresh Player Count"
		end
	end)
end)

--==================================================
-- SERVER DEBUG INFO
--==================================================

local ServerInfoButton = CreateButton("Server Debug Info")

ServerInfoButton.MouseButton1Click:Connect(function()
	print("========== SERVER DEBUG ==========")
	print("PlaceId:", game.PlaceId)
	print("JobId:", game.JobId)
	print("Players:", #Players:GetPlayers())
	print("Client:", LocalPlayer.Name)
	print("==================================")
end)
