--=========================================================
-- FREECAM
--=========================================================

local Freecam = {
	Active = false,
	Position = Vector3.zero,
	Rotation = Vector2.zero,
	Speed = 50,
}

local function StartFreecam()
	if Freecam.Active then
		return
	end

	Freecam.Active = true
	CONFIG.Freecam = true

	Freecam.Position = Camera.CFrame.Position

	local x, y, _ = Camera.CFrame:ToOrientation()
	Freecam.Rotation = Vector2.new(x, y)

	Camera.CameraType = Enum.CameraType.Scriptable

	Notify(
		"Freecam",
		"Use WASD + Space + Ctrl. Hold Shift to move faster.",
		4
	)
end

local function StopFreecam()
	if not Freecam.Active then
		return
	end

	Freecam.Active = false
	CONFIG.Freecam = false

	Camera.CameraType = Enum.CameraType.Custom

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		Camera.CameraSubject = humanoid
	end

	Notify("Freecam", "Freecam disabled.", 2)
end

Button(
	CameraPage,
	"Toggle Freecam",
	function(button)
		if Freecam.Active then
			StopFreecam()
			button.Text = "Enable Freecam"
		else
			StartFreecam()
			button.Text = "Disable Freecam"
		end
	end
)

Button(
	CameraPage,
	"Freecam Speed +",
	function()
		Freecam.Speed = math.clamp(
			Freecam.Speed + 10,
			10,
			300
		)

		Notify(
			"Freecam",
			"Speed: " .. Freecam.Speed,
			1.5
		)
	end
)

Button(
	CameraPage,
	"Freecam Speed -",
	function()
		Freecam.Speed = math.clamp(
			Freecam.Speed - 10,
			10,
			300
		)

		Notify(
			"Freecam",
			"Speed: " .. Freecam.Speed,
			1.5
		)
	end
)

