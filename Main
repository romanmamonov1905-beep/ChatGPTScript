local Freecam = {
	Active = false,
	Position = Vector3.zero,
	Rotation = Vector2.zero,
	Speed = 60,
}

local function StartFreecam()
	UpdateCharacter()

	if not Root then
		return
	end

	Freecam.Active = true
	CFG.Freecam = true

	Freecam.Position = Camera.CFrame.Position

	local rx, ry, _ =
		Camera.CFrame:ToOrientation()

	Freecam.Rotation =
		Vector2.new(rx, ry)

	Camera.CameraType =
		Enum.CameraType.Scriptable

	Notify(
		"Freecam",
		"WASD + Space + Ctrl | Shift = boost",
		3
	)
end

local function StopFreecam()
	Freecam.Active = false
	CFG.Freecam = false

	Camera.CameraType =
		Enum.CameraType.Custom

	UpdateCharacter()

	if Humanoid then
		Camera.CameraSubject = Humanoid
	end
end

Button(
	CameraPage,
	"Toggle Freecam",
	function(button)
		if Freecam.Active then
			StopFreecam()
			button.Text = "Enable Freecam"
		else
			StartFreecam()
			button.Text = "Disable Freecam"
		end
	end
)

Button(
	CameraPage,
	"Freecam Speed +",
	function()
		Freecam.Speed =
			math.clamp(
				Freecam.Speed + 15,
				10,
				300
			)

		Notify(
			"Freecam",
			"Speed: " .. Freecam.Speed,
			1.5
		)
	end
)

Button(
	CameraPage,
	"Freecam Speed -",
