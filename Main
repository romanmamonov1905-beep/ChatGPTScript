local PlayerList = New("ScrollingFrame", {
	Size = UDim2.new(1, -4, 0, 170),
	BackgroundColor3 = CONFIG.Panel,
	BorderSizePixel = 0,
	ScrollBarThickness = 3,
	ScrollBarImageColor3 = CONFIG.Accent,
}, PlayersPage)

Corner(PlayerList, 8)

New("UIListLayout", {
	Padding = UDim.new(0, 4),
}, PlayerList)

New("UIPadding", {
	PaddingTop = UDim.new(0, 6),
	PaddingLeft = UDim.new(0, 6),
	PaddingRight = UDim.new(0, 6),
	PaddingBottom = UDim.new(0, 6),
}, PlayerList)

local function RefreshPlayerList()
	for _, child in ipairs(PlayerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local query = string.lower(SearchBox.Text)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if query == ""
				or string.find(string.lower(player.Name), query, 1, true)
				or string.find(string.lower(player.DisplayName), query, 1, true)
			then
				local button = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 34),
					BackgroundColor3 =
						selectedPlayer == player
						and Color3.fromRGB(60, 36, 80)
						or CONFIG.Panel2,
					BorderSizePixel = 0,
					Text = "  " .. player.DisplayName .. "  @" .. player.Name,
					TextColor3 = CONFIG.Text,
					Font = Enum.Font.GothamSemibold,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
				}, PlayerList)

				Corner(button, 6)

				button.MouseButton1Click:Connect(function()
					selectedPlayer = player
					RefreshPlayerList()
					Notify(
						"Player Selected",
						player.DisplayName .. "  @" .. player.Name,
						2
					)
				end)
			end
		end
	end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshPlayerList)
Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(RefreshPlayerList)

RefreshPlayerList()

local SelectedInfo = Info(
	PlayersPage,
	"No player selected."
)

RunService.RenderStepped:Connect(function()
	if selectedPlayer and selectedPlayer.Parent then
		local character = selectedPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			SelectedInfo.Text =
				"  " ..
				selectedPlayer.DisplayName ..
				"  | HP: " ..
				math.floor(humanoid.Health) ..
				" / " ..
				math.floor(humanoid.MaxHealth) ..
				"  | Team: " ..
				(selectedPlayer.Team and selectedPlayer.Team.Name or "None")
		end
	end
end)

Button(
	PlayersPage,
	"Inspect Selected Player",
	function()
		if not selectedPlayer then
			Notify("Inspector", "Select a player first.", 2)
			return
		end

		local character = selectedPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")

		print("========== PLAYER INSPECTOR ==========")
		print("Name:", selectedPlayer.Name)
		print("DisplayName:", selectedPlayer.DisplayName)
		print("UserId:", selectedPlayer.UserId)
		print("Team:", selectedPlayer.Team and selectedPlayer.Team.Name or "None")

		if humanoid then
			print("Health:", humanoid.Health)
			print("MaxHealth:", humanoid.MaxHealth)
		end

		if root then
			print("Position:", root.Position)
		end

		print("======================================")

		Notify(
			"Inspector",
			"Player information sent to the Developer Console.",
			3
		)
	end
)

Button(
	PlayersPage,
	"Spectate Selected",
	function()
		if not selectedPlayer then
			Notify("Spectate", "Select a player first.", 2)
			return
		end

		local character = selectedPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			Camera.CameraSubject = humanoid
			CONFIG.Spectating = true
			Notify("Spectate", "Spectating " .. selectedPlayer.Name, 2)
		end
	end
)

Button(
	PlayersPage,
	"Stop Spectating",
	function()
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			Camera.CameraSubject = humanoid
			CONFIG.Spectating = false
			Notify("Spectate", "Returned to your character.", 2)
		end
	end
)

