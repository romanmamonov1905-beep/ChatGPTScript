	PowerPage,
	"Noclip",
	false,
	function(value)
		CFG.Noclip = value

		if not value then
			for part, collision in pairs(OriginalCollision) do
				if part and part.Parent then
					part.CanCollide = collision
				end
			end

			table.clear(OriginalCollision)

			Notify(
				"Noclip",
				"Collision restored.",
				2
			)
		else
			Notify(
				"Noclip",
				"Noclip enabled.",
				2
			)
		end
	end
)

--=========================================================
-- GODMODE
--=========================================================

local GodConnection

local function EnableGodMode()
	UpdateCharacter()

	if not Humanoid then
		return
	end

	Humanoid.MaxHealth = 1000000000
	Humanoid.Health = Humanoid.MaxHealth

	if GodConnection then
		GodConnection:Disconnect()
	end

	GodConnection = Humanoid.HealthChanged:Connect(function()
		if CFG.GodMode and Humanoid.Parent then
			if Humanoid.Health < Humanoid.MaxHealth then
				Humanoid.Health = Humanoid.MaxHealth
			end
		end
	end)
end

local function DisableGodMode()
	if GodConnection then
		GodConnection:Disconnect()
		GodConnection = nil
	end

	UpdateCharacter()

	if Humanoid then
		Humanoid.MaxHealth = 100
		Humanoid.Health =
			math.min(Humanoid.Health, 100)
	end
end

Toggle(
	PowerPage,
	"GodMode",
	false,
	function(value)
		CFG.GodMode = value

		if value then
			EnableGodMode()
			Notify(
				"GodMode",
				"Local health protection enabled.",
				2
			)
		else
			DisableGodMode()
		end
	end
)

