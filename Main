local selectedPlayer = nil

local SearchBox = New("TextBox", {
	Size = UDim2.new(1, -4, 0, 40),
	BackgroundColor3 = CONFIG.Panel2,
	BorderSizePixel = 0,
	PlaceholderText = "Search player...",
